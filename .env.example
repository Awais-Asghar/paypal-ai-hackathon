# Copy to .env and fill in. Never commit .env.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Sandbox personal accounts (from Developer Dashboard → Testing tools → Sandbox accounts)
SANDBOX_NANA_EMAIL=
SANDBOX_ALI_EMAIL=

# Log In with PayPal return URL (must match the app's settings in the Developer Dashboard)
PAYPAL_LOGIN_REDIRECT_URI=http://localhost:3000/callback

ANTHROPIC_API_KEY=
DATABASE_URL=
APP_BASE_URL=http://localhost:3000
