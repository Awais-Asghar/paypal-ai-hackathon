# Copy to .env and fill in. Never commit .env.
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Must match the sandbox accounts' country (all our sandbox accounts are Canada → CAD)
PAYPAL_CURRENCY=CAD

# Sandbox personal accounts (from Developer Dashboard → Testing tools → Sandbox accounts)
SANDBOX_MARGARET_EMAIL=
SANDBOX_ETHAN_EMAIL=
SANDBOX_ROBERT_EMAIL=
# Optional: shown on the Judge Mode page so judges can log in (sandbox accounts only, fake money)
SANDBOX_MARGARET_PASSWORD=
SANDBOX_ETHAN_PASSWORD=
# Ethan's payer_id from `scripts/sandbox-check.mjs login`. Payouts to family go to this PayPal ID only.
SANDBOX_ETHAN_PAYER_ID=

# Log In with PayPal return URL (must match the app's settings in the Developer Dashboard)
PAYPAL_LOGIN_REDIRECT_URI=http://127.0.0.1:3000/callback

# AI provider: gemini (default, free tier) | groq | anthropic. Switch here, no code changes.
LLM_PROVIDER=gemini
# Main Gemini key, plus an optional backup key from a different Google project
GEMINI_API_KEY_Pro=
GEMINI_API_KEY_Plus=
GEMINI_MODEL=gemini-3.8-flash
# Groq (free): voicemail transcription, fast fallback chat, prompt-injection screening
GROQ_API_KEY=
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_STT_MODEL=whisper-large-v3-turbo
# Optional: only if LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Empty = local PGlite in ./.pglite (nothing to install). A postgres:// URL uses that server (Render).
DATABASE_URL=
# 127.0.0.1, not localhost, to match the Log In with PayPal return URL
APP_BASE_URL=http://127.0.0.1:3000

# Scheduler secret for POST /api/cron/sweep (Authorization: Bearer <secret>)
CRON_SECRET=
# 1 enables Judge Mode controls such as skipping the cooling-off timer
JUDGE_MODE=0
COOLING_OFF_HOURS=24
